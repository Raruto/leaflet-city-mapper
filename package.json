{
  "name": "leaflet-city-mapper",
  "version": "0.1.0",
  "description": "A small 3D rendering engine for leaflet",
  "type": "module",
  "main": "dist/leaflet-city-mapper.js",
  "browser": "dist/leaflet-city-mapper.js",
  "module": "src/index.js",
  "scripts": {
    "dev": "node build/dev.js",
    "build": "node build/build.js",
    "test": "node build/test.js",
    "pmtiles": "node build/pmtiles.js",
    "preversion": "node build/version.js",
    "version": "npm run build && git add -A",
    "postversion": "npm publish --access public && git push --follow-tags"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raruto/leaflet-city-mapper.git"
  },
  "keywords": [
    "leaflet",
    "3d",
    "rotation",
    "webgpu",
    "terrain",
    "pmtiles"
  ],
  "author": {
    "name": "Raruto",
    "url": "https://github.com/Raruto/leaflet-city-mapper"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Raruto/leaflet-city-mapper/issues"
  },
  "homepage": "https://github.com/Raruto/leaflet-city-mapper#readme",
  "peerDependencies": {
    "leaflet": "^1.9.3 || ^2.0.0-beta.3",
    "ol": "^10.6.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "acorn": "^8.15.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
